[Setup]
AppName=SlabCalc
AppVersion=1.0.0
DefaultDirName={autopf}\SlabCalc
DefaultGroupName=SlabCalc
OutputBaseFilename=SlabCalc-Setup-2.0.0
OutputDir=instalador
Compression=lzma2
SolidCompression=yes
ArchitecturesInstallIn64BitMode=x64compatible
SetupIconFile=assets\ico.ico
UninstallDisplayIcon={app}\SlabCalc.exe

[Files]
Source: "dist\SlabCalc\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion

[Icons]
Name: "{group}\SlabCalc"; Filename: "{app}\SlabCalc.exe"
Name: "{autodesktop}\SlabCalc"; Filename: "{app}\SlabCalc.exe"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Criar atalho na área de trabalho"

[Run]
Filename: "{app}\SlabCalc.exe"; Description: "Abrir o programa"; Flags: nowait postinstall skipifsilent